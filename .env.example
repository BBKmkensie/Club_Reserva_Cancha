# Copia este archivo como .env y completa con tus datos.
# No subas el archivo .env a GitHub (contiene contraseñas).

# Base de datos (PostgreSQL)
# Local:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=tu_contraseña
# DB_DATABASE=proyecto_taller
#
# Azure (requiere SSL):
# DB_HOST=tu-servidor.postgres.database.azure.com
# DB_PORT=5432
# DB_USERNAME=admin@tu-servidor
# DB_PASSWORD=tu_contraseña
# DB_DATABASE=postgres
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_contraseña
DB_DATABASE=proyecto_taller
DB_SSL=false

# Puerto del backend NestJS
PORT=3000

# JWT (opcional; si no se define, el backend usa un valor por defecto en desarrollo)
# JWT_SECRET=cambia_esto_en_produccion

# Correo electrónico (SMTP)
# Desarrollo: deja MAIL_ENABLED=false para simular envíos en la consola del backend.
# Producción / pruebas reales: MAIL_ENABLED=true y completa SMTP_*.
MAIL_ENABLED=false
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Reservas Cancha <noreply@reservas.local>
# URL del frontend (enlaces en correos a la directiva)
FRONTEND_URL=http://localhost:4200
